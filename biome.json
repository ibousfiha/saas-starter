{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!.fallow",
      "!**/dist",
      "!**/.turbo",
      "!**/routeTree.gen.ts",
      "!**/locales/*/messages.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.bun",
      "!.fallowrc.json",
      "!.playwright-cli"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "noAutofocus": "error",
        "useAltText": "error",
        "useHeadingContent": "error",
        "useSemanticElements": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["clsx", "cva", "cn"]
          }
        }
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noConsole": "warn",
        "noFocusedTests": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "noEqualsToNull": "off",
        "noLeakedRender": "off"
      },
      "style": {
        "noDoneCallback": "error",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": ["Bun"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      "includes": ["packages/ui/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementInteractions": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/i18n/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/routes/*.$*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/check-translations.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@saas-starter/auth": "Server-only. The web app talks to the server through lib/auth-client.ts and oRPC; role checks come from @saas-starter/auth/permissions.",
                  "@saas-starter/db": "Server-only. Fetch data through oRPC instead.",
                  "@saas-starter/auth/redis": "Server-only.",
                  "@saas-starter/email": "Server-only.",
                  "@saas-starter/env/server": "Server-only. The web app has no env vars; use relative URLs."
                },
                "patterns": [
                  {
                    "group": ["@saas-starter/db/**", "@saas-starter/email/**"],
                    "message": "Server-only package."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
  "name": "@saas-starter/server",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --outdir=dist --sourcemap=linked && bun build ../../packages/db/src/migrate.ts --target=bun --outdir=dist --sourcemap=linked && cp -R ../../packages/db/src/migrations dist/migrations",
    "check-types": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@saas-starter/api": "workspace:*",
    "@saas-starter/auth": "workspace:*",
    "@saas-starter/config": "workspace:*",
    "@saas-starter/db": "workspace:*",
    "@saas-starter/env": "workspace:*",
    "evlog": "^2.14.1",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}

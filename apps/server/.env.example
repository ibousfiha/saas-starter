# Required
APP_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32-output
DATABASE_URL=postgresql://postgres:password@localhost:5433/saas-starter
REDIS_URL=redis://localhost:6380

# Server
# PORT=3000
# LOG_LEVEL=info
# LOG_DB_QUERIES=false
# WEB_DIST_DIR=/app/apps/web/dist
# Set to true only behind a reverse proxy that sets X-Forwarded-For (used for rate limiting).
# TRUST_PROXY=false

# Email: Resend when RESEND_API_KEY is set, otherwise SMTP (Mailpit in dev, UI at http://localhost:8026).
# Production requires FROM_EMAIL and either RESEND_API_KEY or SMTP_HOST.
# FROM_EMAIL=noreply@example.com
# RESEND_API_KEY=
# SMTP_HOST=localhost
# SMTP_PORT=1026
# SMTP_USER=
# SMTP_PASSWORD=

# Dev seed (bun run db:seed)
# SEED_EMAIL=admin@example.com
# SEED_PASSWORD=admin123
# SEED_NAME=Admin
# SEED_ORG_NAME=My Organization
# SEED_ORG_SLUG=my-organization
